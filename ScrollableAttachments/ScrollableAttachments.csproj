<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <AssemblyName>$(ModName)</AssemblyName>
        <RootNamespace>AttachmentScrolling</RootNamespace>
        <Product>$(ModDisplayName)</Product>
        <Authors>$(ModAuthor)</Authors>
        <RepositoryUrl>$(ModSourceRepository)</RepositoryUrl>
        <Description>$(ModDisplayName) client plugin for SPT $(SupportedSptVersion).</Description>
        <PackageId>$(ModName)</PackageId>
        <Version>$(ModVersion)</Version>
        <AssemblyVersion>$(ModVersion)</AssemblyVersion>
        <FileVersion>$(ModVersion)</FileVersion>
        <InformationalVersion>$(ModVersion)</InformationalVersion>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <SPTModType>Client</SPTModType>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>SupportedSptVersion</_Parameter1>
            <_Parameter2>$(SupportedSptVersion)</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>

    <ItemGroup Condition="'$(SPTPath)' != ''">
        <Reference Include="0Harmony">
            <HintPath>$(BepInExCoreDir)\0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(SptManagedDir)\Assembly-CSharp.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="BepInEx">
            <HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="Sirenix.Serialization">
            <HintPath>$(SptManagedDir)\Sirenix.Serialization.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="spt-reflection">
            <HintPath>$(SptPluginsDir)\spt-reflection.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(SptManagedDir)\UnityEngine.CoreModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine">
            <HintPath>$(SptManagedDir)\UnityEngine.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.InputModule">
            <HintPath>$(SptManagedDir)\UnityEngine.InputModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.UI">
            <HintPath>$(SptManagedDir)\UnityEngine.UI.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="UnityEngine.UIModule">
            <HintPath>$(SptManagedDir)\UnityEngine.UIModule.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="ZLinq">
            <HintPath>$(UnityToolkitDir)\ZLinq.dll</HintPath>
            <Private>false</Private>
        </Reference>
    </ItemGroup>
</Project>
