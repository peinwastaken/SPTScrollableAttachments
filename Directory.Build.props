<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <!-- Keep mod identity and release version in one place. -->
        <ModVersion>1.2.0</ModVersion>
        <ModGuid>com.pein.attachmentscrolling</ModGuid>
        <ModAuthor>pein</ModAuthor>
        <ModName>ScrollableAttachments</ModName>
        <ModDisplayName>$(ModAuthor)-$(ModName)</ModDisplayName>
        <ModSourceRepository>https://github.com/peinwastaken/SPTScrollableAttachments</ModSourceRepository>
        <SupportedSptVersion>4.1.x</SupportedSptVersion>

        <!-- Pass /p:SPTPath=... or set SPT_PATH for the local SPT installation. -->
        <SPTPath Condition="'$(SPTPath)' == '' and '$(SPT_PATH)' != ''">$(SPT_PATH)</SPTPath>
        <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
        <ReleaseRoot>$(RepoRoot)Release</ReleaseRoot>
        <ClientReleaseFolder>BepInEx\plugins\$(ModDisplayName)</ClientReleaseFolder>

        <SptManagedDir>$(SPTPath)\EscapeFromTarkov_Data\Managed</SptManagedDir>
        <BepInExCoreDir>$(SPTPath)\BepInEx\core</BepInExCoreDir>
        <SptPluginsDir>$(SPTPath)\BepInEx\plugins\spt</SptPluginsDir>
        <UnityToolkitDir>$(SPTPath)\BepInEx\plugins\UnityToolkit</UnityToolkitDir>
    </PropertyGroup>
</Project>
