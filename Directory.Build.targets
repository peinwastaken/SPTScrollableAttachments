<Project>
    <PropertyGroup>
        <GeneratedModInfoPath Condition="'$(GeneratedModInfoPath)' == ''">$(IntermediateOutputPath)Generated\ModInfo.g.cs</GeneratedModInfoPath>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="$(GeneratedModInfoPath)" AutoGen="true" Visible="false" />
    </ItemGroup>

    <Target Name="ValidateSptPath" BeforeTargets="ResolveReferences" Condition="'$(DesignTimeBuild)' != 'true'">
        <Error
            Condition="'$(SPTPath)' == ''"
            Text="SPTPath is required. Pass /p:SPTPath=&lt;SPT installation path&gt; or set the SPT_PATH environment variable." />
        <Error
            Condition="'$(SPTPath)' != '' and !Exists('$(SptManagedDir)')"
            Text="SPTPath '$(SPTPath)' does not contain EscapeFromTarkov_Data\Managed. Check /p:SPTPath or SPT_PATH." />
        <Error
            Condition="'$(SPTPath)' != '' and !Exists('$(BepInExCoreDir)')"
            Text="SPTPath '$(SPTPath)' does not contain BepInEx\core. Check /p:SPTPath or SPT_PATH." />
        <Error
            Condition="'$(SPTPath)' != '' and !Exists('$(SptPluginsDir)\spt-reflection.dll')"
            Text="SPTPath '$(SPTPath)' is missing BepInEx\plugins\spt\spt-reflection.dll. Install the matching SPT client files." />
        <Error
            Condition="'$(SPTPath)' != '' and !Exists('$(UnityToolkitDir)\ZLinq.dll')"
            Text="SPTPath '$(SPTPath)' is missing BepInEx\plugins\UnityToolkit\ZLinq.dll. Install the required UnityToolkit plugin." />
    </Target>

    <Target Name="GenerateModInfo" BeforeTargets="CoreCompile" DependsOnTargets="ValidateSptPath" Condition="'$(DesignTimeBuild)' != 'true'">
        <MakeDir Directories="$(IntermediateOutputPath)Generated" />
        <ItemGroup>
            <GeneratedModInfoLines Include="// &lt;auto-generated /&gt;" />
            <GeneratedModInfoLines Include="namespace AttachmentScrolling%3B" />
            <GeneratedModInfoLines Include="internal static class ModInfo" />
            <GeneratedModInfoLines Include="{" />
            <GeneratedModInfoLines Include="    internal const string Guid = &quot;$(ModGuid)&quot;%3B" />
            <GeneratedModInfoLines Include="    internal const string Name = &quot;$(ModDisplayName)&quot;%3B" />
            <GeneratedModInfoLines Include="    internal const string Version = &quot;$(ModVersion)&quot;%3B" />
            <GeneratedModInfoLines Include="    internal const string Author = &quot;$(ModAuthor)&quot;%3B" />
            <GeneratedModInfoLines Include="    internal const string SourceRepository = &quot;$(ModSourceRepository)&quot;%3B" />
            <GeneratedModInfoLines Include="}" />
        </ItemGroup>
        <WriteLinesToFile
            File="$(GeneratedModInfoPath)"
            Lines="@(GeneratedModInfoLines)"
            Overwrite="true"
            Encoding="UTF-8" />
    </Target>

    <Target Name="StageReleasePackage" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
        <MakeDir Directories="$(ReleaseRoot)\$(ClientReleaseFolder)" />
        <Copy
            SourceFiles="$(TargetPath)"
            DestinationFiles="$(ReleaseRoot)\$(ClientReleaseFolder)\$(TargetFileName)"
            SkipUnchangedFiles="true"
            ContinueOnError="false" />
        <Message
            Text="Staged runtime package: $(ReleaseRoot)\$(ClientReleaseFolder)\$(TargetFileName)"
            Importance="high" />
    </Target>
</Project>
